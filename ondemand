/*
 * EApp left-navigation launcher.
 *
 * Replaces the legacy direct Function-key XMLHttpRequest with the existing
 * KOFC.Auth SPA flow:
 *   D365 web resource -> MSAL delegated token -> Boomi -> EApp Function -> EApp.
 *
 * Required Dataverse environment variables:
 *   kofc_EappTenantId
 *   kofc_EappClientId
 *   kofc_EappApiAppId
 *   kofc_EappApiKey
 *   kofc_EappIntfunctionURL
 *   kofc_EappURL
 *
 * Optional:
 *   kofc_EappScope (defaults to Contact.Read)
 */
var KOFC = KOFC || {};

KOFC.EappLeftNav = (function (global) {
    "use strict";

    var AUTH_CLIENT_PATH = "/WebResources/kofc_authclient.js";
    var ENV = {
        tenantId: "kofc_EappTenantId",
        clientId: "kofc_EappClientId",
        apiAppId: "kofc_EappApiAppId",
        apiKey: "kofc_EappApiKey",
        boomiUrl: "kofc_EappIntfunctionURL",
        eappUrl: "kofc_EappURL",
        scope: "kofc_EappScope"
    };

    function getXrm() {
        if (global.Xrm) {
            return global.Xrm;
        }
        if (global.parent && global.parent.Xrm) {
            return global.parent.Xrm;
        }
        if (global.opener && global.opener.Xrm) {
            return global.opener.Xrm;
        }
        throw new Error("Dynamics 365 context is unavailable.");
    }

    function setStatus(message, isError) {
        var element = global.document.getElementById("status");
        if (!element) {
            return;
        }
        element.textContent = message;
        element.className = isError ? "error" : "";
    }

    function stripBraces(value) {
        return String(value || "").replace(/[{}]/g, "").trim();
    }

    function getClientUrl() {
        return getXrm().Utility.getGlobalContext().getClientUrl();
    }

    async function getEnvironmentVariable(schemaName, optional) {
        var xrm = getXrm();
        var escapedName = schemaName.replace(/'/g, "''");
        var query =
            "?$select=defaultvalue" +
            "&$filter=schemaname eq '" + escapedName + "'" +
            "&$expand=environmentvariabledefinition_environmentvariablevalue($select=value)";
        var result = await xrm.WebApi.retrieveMultipleRecords(
            "environmentvariabledefinition",
            query
        );

        if (!result || !result.entities || result.entities.length === 0) {
            if (optional) {
                return null;
            }
            throw new Error("Environment variable was not found: " + schemaName);
        }

        var definition = result.entities[0];
        var values = definition.environmentvariabledefinition_environmentvariablevalue;
        var value = values && values.length > 0 ? values[0].value : definition.defaultvalue;

        if (!value && !optional) {
            throw new Error("Environment variable has no current or default value: " + schemaName);
        }
        return value || null;
    }

    function loadAuthClient() {
        return new Promise(function (resolve, reject) {
            if (global.KOFC && global.KOFC.Auth) {
                resolve();
                return;
            }

            var script = global.document.createElement("script");
            script.src = getClientUrl() + AUTH_CLIENT_PATH;
            script.onload = function () {
                if (global.KOFC && global.KOFC.Auth) {
                    resolve();
                } else {
                    reject(new Error("Auth client loaded, but KOFC.Auth is unavailable."));
                }
            };
            script.onerror = function () {
                reject(new Error("Failed to load EApp SPA auth client."));
            };
            global.document.head.appendChild(script);
        });
    }

    async function loadConfiguration() {
        var values = await Promise.all([
            getEnvironmentVariable(ENV.tenantId),
            getEnvironmentVariable(ENV.clientId),
            getEnvironmentVariable(ENV.apiAppId),
            getEnvironmentVariable(ENV.apiKey),
            getEnvironmentVariable(ENV.boomiUrl),
            getEnvironmentVariable(ENV.eappUrl),
            getEnvironmentVariable(ENV.scope, true)
        ]);

        return {
            auth: {
                tenantId: values[0],
                clientId: values[1],
                apiAppId: values[2],
                apiKey: values[3],
                boomiUrl: values[4],
                scope: values[6] || "Contact.Read",
                httpMethod: "POST",
                redirectWebResource: "kofc_authcallback.html",
                msalWebResourcePath: "/WebResources/kofc_msalbrowsermin",
                allowRedirect: true,
                debug: false
            },
            eappUrl: values[5]
        };
    }

    async function start() {
        var xrm;
        try {
            xrm = getXrm();
            setStatus("Signing in and opening EApp...", false);
            xrm.Utility.showProgressIndicator("Processing EApp request...");

            var configuration = await loadConfiguration();
            await loadAuthClient();
            global.KOFC.Auth.configure(configuration.auth);

            // The current auth client still accepts userId for backward compatibility.
            // The delegated EApp Function ignores this legacy parameter and binds the
            // Dataverse CallerId exclusively to the signed token's oid claim.
            var userId = stripBraces(xrm.Utility.getGlobalContext().userSettings.userId);
            var openedUrl = await global.KOFC.Auth.openEapp(
                userId,
                null,
                configuration.eappUrl
            );

            xrm.Utility.closeProgressIndicator();
            if (openedUrl) {
                setStatus("EApp opened. This window can be closed.", false);
                global.setTimeout(function () {
                    try {
                        global.close();
                    } catch (ignore) {
                        // The hosting shell may not allow scripted close.
                    }
                }, 1500);
            } else {
                setStatus("Redirecting to complete sign-in...", false);
            }
        } catch (error) {
            if (xrm && xrm.Utility) {
                xrm.Utility.closeProgressIndicator();
            }
            var message = error && error.message ? error.message : String(error);
            setStatus(message, true);
            if (xrm && xrm.Navigation) {
                await xrm.Navigation.openAlertDialog({ text: message });
            }
        }
    }

    return {
        start: start
    };
})(window);



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Open EApp</title>
    <script src="../ClientGlobalContext.js.aspx" type="text/javascript"></script>
    <script src="./kofc_eapp_leftnav.js" type="text/javascript"></script>
    <style>
        body {
            margin: 0;
            padding: 16px;
            background: #ffffff;
            color: #323130;
            font: 14px "Segoe UI", Arial, sans-serif;
        }

        #status {
            line-height: 1.5;
        }

        .error {
            color: #a4262c;
        }
    </style>
</head>
<body>
    <div id="status" role="status" aria-live="polite">Preparing EApp sign-in...</div>
    <script type="text/javascript">
        window.addEventListener("load", function () {
            if (window.KOFC && window.KOFC.EappLeftNav) {
                window.KOFC.EappLeftNav.start();
            }
        });
    </script>
</body>
</html>
