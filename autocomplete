function navigateToNavigator(navFunctionAppURL,PrimaryControl,navigatorURL)
{

 try {
        
	 var formContext = PrimaryControl;
     var contactLookup = PrimaryControl._ui._formContext.getAttribute("parentcontactid");

    if (contactLookup != null && contactLookup.getValue() != null) {
        // Retrieve the contact ID
        var contactId = contactLookup.getValue()[0].id;  // The ID of the contact in the lookup

        // Clean the GUID format
        contactId = contactId.replace("{", "").replace("}", "");
    
    } else {
        // Show an error message if contact lookup is empty
        Xrm.Navigation.openAlertDialog({ text: "Contact is not selected in the Opportunity form." });
    }



        // Construct the Function App URL with the contact ID
        var functionappURL = `${navFunctionAppURL}&type=contact&contactId=${contactId}`;

        var requestOptions = {
            method: "GET",
            headers: {
                "Content-Type": "application/json; charset=utf-8",
                "Accept": "application/json"
            }
        };

        // Show progress indicator to the user
        Xrm.Utility.showProgressIndicator("Processing Request... Please Wait.");

        // Make the fetch call
        fetch(functionappURL, requestOptions)
            .then(response => {
                if (!response.ok) {
                    const errorMessage = response.status === 404
                        ? "Client Not Found."
                        : "Failed to fetch response!";
                   
                    // Show alert dialog and wait for the dialog to complete
                    return Xrm.Navigation.openAlertDialog({ text: errorMessage }).then(() => {
                        throw new Error(errorMessage);
                    });
                }
                return response.json(); // Parse JSON response if the call is successful
            })
            .then(responseData => {
                if (!responseData || (!responseData.indicator && !responseData.data)) {
                    Xrm.Utility.closeProgressIndicator();
                    return Xrm.Navigation.openAlertDialog({
                        text: "This functionality is not yet available. Build in progress!"
                    });
                }

                // Extract tracking ID and build the final navigator URL
                var transTrackingID = responseData.data.replace(/"/g, '');
                var finalNavigatorURL = `${navigatorURL}&CurrentPage=Client&GatewayServicePayloadId=${transTrackingID}`;

                // Open the navigator URL in a new window
                Xrm.Utility.closeProgressIndicator();
                const newWindow = window.open(finalNavigatorURL, "_blank");

                if (!newWindow) {
                    console.error("The new window is not accessible.");
                    return Xrm.Navigation.openAlertDialog({
                        text: "Failed to open new window."
