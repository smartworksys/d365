    var productCategoryOptionSet;
    var formContext = executionContext.getFormContext();
    var fetchQuery;
    try {
        productCategoryOptionSet = formContext.getControl('kofc_productcategory').getAttribute().getValue();
        if (productCategoryOptionSet !== null && productCategoryOptionSet !== undefined) {
            fetchQuery = "<filter type='and'><condition attribute = 'kofc_productcategory' operator = 'eq' value = '" + productCategoryOptionSet + "' /></filter>";
