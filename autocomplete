<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Opening file...</title>
    <!--
      kofc_blob_open.html — Timeline / ADF link landing page

      Load order:
        1. kofc_authclient.js
        2. kofc_blobClient.js
        3. kofc_msalbrowsermin
        4. inline init

      Env vars (Text):
        kofc_BlobTenantId, kofc_BlobClientId, kofc_BlobApiAppId,
        kofc_BlobApiKey, kofc_BlobBoomiUrl

      Link contract (any integrator — ADF, plugin, flow):
        Preferred (simple for ADF — encode data once):
          &data=<uriComponent( path + "|" + contactId )>
        Also supported:
          &data=<uriComponent( "path=" + path + "&contactId=" + contactId )>
          &path=<path>&contactId=<guid>  (when query params are preserved)
    -->
    <style>
        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f3f2f1;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            color: #323130;
        }
        .card {
            background: #fff;
            border: 1px solid #e1dfdd;
            border-radius: 8px;
            padding: 32px 28px;
            max-width: 420px;
            text-align: center;
            box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        }
        .spinner {
            width: 36px;
            height: 36px;
            border: 3px solid #edebe9;
            border-top-color: #0078d4;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin: 0 auto 16px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .error { color: #a4262c; white-space: pre-wrap; text-align: left; }
        h1 { font-size: 18px; margin: 0 0 8px; }
        p { margin: 0; color: #605e5c; font-size: 14px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="spinner" id="loader"></div>
        <h1 id="title">Opening file</h1>
        <p id="message">Authenticating and requesting secure access...</p>
        <pre class="error" id="error" style="display:none;"></pre>
    </div>

    <script src="/WebResources/kofc_authclient.js"></script>
    <script src="/WebResources/kofc_blobClient.js"></script>
    <script src="/WebResources/kofc_msalbrowsermin"></script>
    <script>
        (function () {
            "use strict";

            var ENV = {
                tenantId: "kofc_TenantId",
                clientId: "kofc_SPAClientId",
                apiAppId: "kofc_BlobApiAppId",
                apiKey: "kofc_EappApiKey",
                boomiUrl: "kofc_BlobBoomiUrl"
            };

            function xrm() {
                try { return parent.Xrm; } catch (e) { return null; }
            }

            function showError(message) {
                document.getElementById("loader").style.display = "none";
                document.getElementById("title").innerText = "Unable to open file";
                document.getElementById("message").style.display = "none";
                var err = document.getElementById("error");
                err.style.display = "block";
                err.innerText = message || "Unknown error";
            }

            function stripBraces(value) {
                return String(value || "").replace(/[{}]/g, "").trim();
            }

            function tryDecode(value) {
                if (!value) { return value; }
                try {
                    return decodeURIComponent(value);
                } catch (e) {
                    return value;
                }
            }

            /**
             * Accepts path + contactId from:
             *  1) Top-level ?path=...&contactId=...
             *  2) data = "path|contactId"  (ADF-friendly: encode once)
             *  3) data = "path=...&contactId=..." (classic nested query)
             */
            function parseContext() {
                var params = new URLSearchParams(window.location.search);
                var path = params.get("path");
                var contactId = params.get("contactId");
                var data = params.get("data") || "";

                if (path && contactId) {
                    return {
                        path: tryDecode(path),
                        contactId: stripBraces(contactId)
                    };
                }

                if (data) {
                    // Prefer path|contactId (contact GUID is last segment after "|")
                    var pipe = data.lastIndexOf("|");
                    if (pipe > 0) {
                        var maybeId = stripBraces(data.substring(pipe + 1));
                        if (/^[0-9a-fA-F-]{36}$/.test(maybeId)) {
                            return {
                                path: tryDecode(data.substring(0, pipe)),
                                contactId: maybeId
                            };
                        }
                    }

                    var nested = new URLSearchParams(data);
                    var nestedPath = nested.get("path");
                    var nestedContact = nested.get("contactId");
                    if (nestedPath && nestedContact) {
                        return {
                            path: tryDecode(nestedPath),
                            contactId: stripBraces(nestedContact)
                        };
                    }

                    // data is only a path; contactId may be top-level
                    if (!nestedPath && contactId) {
                        return {
                            path: tryDecode(data),
                            contactId: stripBraces(contactId)
                        };
                    }
                }

                return {
                    path: path ? tryDecode(path) : null,
                    contactId: stripBraces(contactId)
                };
            }

            function getEnvironmentVariable(schemaName) {
                var api = xrm();
                if (!api) {
                    return Promise.reject(new Error("Dynamics context is unavailable."));
                }
                var query = "?$select=defaultvalue" +
                    "&$filter=schemaname eq '" + schemaName + "'" +
                    "&$expand=environmentvariabledefinition_environmentvariablevalue($select=value)";
                return api.WebApi.retrieveMultipleRecords("environmentvariabledefinition", query)
                    .then(function (result) {
                        if (!result || !result.entities || !result.entities.length) {
                            return null;
                        }
                        var def = result.entities[0];
                        return def.environmentvariabledefinition_environmentvariablevalue &&
                            def.environmentvariabledefinition_environmentvariablevalue.length
                            ? def.environmentvariabledefinition_environmentvariablevalue[0].value
                            : def.defaultvalue;
                    });
            }

            function loadConfig() {
                return Promise.all([
                    getEnvironmentVariable(ENV.tenantId),
                    getEnvironmentVariable(ENV.clientId),
                    getEnvironmentVariable(ENV.apiAppId),
                    getEnvironmentVariable(ENV.apiKey),
                    getEnvironmentVariable(ENV.boomiUrl)
                ]).then(function (values) {
                    var missing = [];
                    if (!values[0]) { missing.push(ENV.tenantId); }
                    if (!values[1]) { missing.push(ENV.clientId); }
                    if (!values[2]) { missing.push(ENV.apiAppId); }
                    if (!values[3]) { missing.push(ENV.apiKey); }
                    if (!values[4]) { missing.push(ENV.boomiUrl); }
                    if (missing.length) {
                        throw new Error("Missing configuration: " + missing.join(", "));
                    }
                    return {
                        tenantId: values[0],
                        clientId: values[1],
                        apiAppId: values[2],
                        apiKey: values[3],
                        boomiUrl: values[4],
                        scope: "access_as_user",
                        httpMethod: "GET",
                        redirectWebResource: "kofc_authcallback.html",
                        msalWebResourcePath: "/WebResources/kofc_msalbrowsermin",
                        allowRedirect: true,
                        debug: false
                    };
                });
            }

            async function init() {
                try {
                    var ctx = parseContext();
                    if (!ctx.path || !ctx.contactId) {
                        throw new Error("Missing path or contactId in link.");
                    }

                    var pending = KOFC.Blob.consumePendingResult();
                    if (pending && pending.ok && pending.data && pending.data.sasUrl) {
                        window.location.href = pending.data.sasUrl;
                        return;
                    }
                    if (pending && !pending.ok) {
                        throw new Error(pending.raw || "Blob request failed after sign-in.");
                    }

                    var config = await loadConfig();
                    KOFC.Blob.configure(config);
                    var result = await KOFC.Blob.openSaasBlob({
                        path: ctx.path,
                        contactId: ctx.contactId
                    });

                    if (result && result.redirecting) {
                        document.getElementById("message").innerText =
                            "Redirecting to sign in. This page will continue automatically.";
                        return;
                    }
                } catch (err) {
                    showError(err && err.message ? err.message : String(err));
                }
            }

            init();
        })();
    </script>
</body>
</html>
