function HasKCCFRole() {
    "use strict";

    var userRoles = Xrm.Utility.getGlobalContext().userSettings.roles;
    var hasKCCFRoleFlag = false;
    if (userRoles !== null && userRoles !== undefined) {
        userRoles.forEach(function (item) {
            if (item.name.toLowerCase() === "kccf leader" || item.name.toLowerCase() === "kccf user" || item.name.toLowerCase() === "kccf vip user") {
                hasKCCFRoleFlag = true;
				return hasKCCFRoleFlag;
            }
        });
    }
    return hasKCCFRoleFlag;
}


