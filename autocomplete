function onLoad(executionContext) {
    "use strict";
    var formContext = executionContext.getFormContext();
    var currentFormID = formContext.ui.formSelector.getCurrentItem().getId();
    var formType = formContext.ui.getFormType();
    var opportunityTypeValue = formContext.getAttribute('kofc_opportunitytype').getValue();
    formContext.data.process.addOnProcessStatusChange(RefreshRibbon);//Added for US_6046 by Dipti
HideKCCFClientOptionBasedOnRole(formContext);
    var flag = true;

    if (formType === 1 && currentFormID.toLowerCase() !== defaultOpportunityFormID.toLowerCase() && flag === true) {
        formContext.data.addOnLoad(setDefaultForm);
    }
    else if (formType !== 1 && currentFormID.toLowerCase() === defaultOpportunityFormID.toLowerCase()) {
        SetFormAndBPFStage(executionContext);
        flag = false;
    }

    if (formType === 1 && currentFormID.toLowerCase() === defaultOpportunityFormID.toLowerCase()) {
        GetLoggedInUserTeamSecurityRole(formContext);
    }
    formContext.data.addOnLoad(ShowHidePainPointValue);
    formContext.data.addOnLoad(SetBPFStage);

    /*Added as part of 6212 story by sreedeepthi*/
    if (currentFormID === insuranceFormID.toLowerCase()) {
        formContext.data.addOnLoad(ShowProductCategoryValues);
    }

    // Removed || currentFormID === institutionalinvestmentFormID form below if condition(Ref US : 6582)
    if (currentFormID === insuranceFormID.toLowerCase() || currentFormID === kccfFormID || currentFormID === retailInvestmentFormID) {
        formContext.data.addOnLoad(FilterProductSubCategory);
    }

    if (opportunityTypeValue === opportunityType.EstablishCor && currentFormID === fraternalFormID.toLowerCase()) {
        formContext.data.addOnLoad(ShowHideCouncilSection);
        formContext.data.addOnLoad(FilterParish);
    }
    if (opportunityTypeValue === opportunityType.NewMember && currentFormID === fraternalFormID.toLowerCase()) {
        formContext.data.addOnLoad(ShowHideCouncilSection);
        formContext.getControl("kofc_painpoints").setVisible(false);
    }
    //Added for US 5742
    if (opportunityTypeValue === opportunityType.CouncilReactivation && currentFormID === fraternalFormID.toLowerCase()) {
        formContext.data.addOnLoad(ShowHideCouncilSection);
    }

    if (opportunityTypeValue === opportunityType.Recruiting && currentFormID === recruitingFormID.toLowerCase()) {
        //formContext.data.addOnLoad(RemoveOpportunitySubTypeValues);
        formContext.data.addOnLoad(ShowHideContactSections);
        // Added for fixing Bug 9725
        // if (formContext.getAttribute("kofc_opportunitysubtype").getValue() !== null && formContext.getAttribute("kofc_opportunitysubtype").getValue() !== undefined) {
        //     var oppSubType = formContext.getAttribute("kofc_opportunitysubtype").getValue();
        //     if (oppSubType === opportunitySubType.FA) {
                formContext.getAttribute("parentcontactid").addOnChange(ShowHideContactSections);
        //         formContext.getAttribute("kofc_opportunitysubtype").addOnChange(ShowExamDetails);
        //     }
        // }

        // if (formContext.getAttribute("kofc_retest").getValue() !== null && formContext.getAttribute("kofc_retest").getValue() !== undefined) {
        //     formContext.data.addOnLoad(ShowExamDetails);
        // }
    }
    //Added for Issue 6256
    if (opportunityTypeValue === opportunityType.Charity && currentFormID === charityFormID.toLowerCase()) {
        formContext.data.addOnLoad(RemoveOpportunitySubTypeValues);
    }

    //Added for 6044 - by sreedeepthi
    if (opportunityTypeValue === opportunityType.KCCF && currentFormID === kccfFormID.toLowerCase()) {
        formContext.data.addOnLoad(SetProductSubCategoryValue);
    }

    // Added for 6038 - by Bheemesh
    if (opportunityTypeValue === opportunityType.InstitutionalInvestment && currentFormID === institutionalinvestmentFormID.toLowerCase()) {
        formContext.data.process.addOnPreStageChange(InstitutionalInvestmentBPFStageMoveHandle);
    }

    // Added for 6457 - by Dipti
    if (opportunityTypeValue === opportunityType.KCCF && currentFormID === kccfFormID.toLowerCase()) {
        formContext.data.process.addOnPreProcessStatusChange(KccfBPFStatusChangeHandle);
    }

    //disable form selector
    formContext.ui.formSelector.items.forEach(
        function (f) {
            f.setVisible(false);
        }
    );
}

