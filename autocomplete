// ADO Item: 51210
// Author: Veera Kolan
// Date: 03/30/2026
// Description: Updated environment variable handling to use a centralized,
// reusable helper that resolves Current Value first with Default Value fallback
// to ensure consistent behavior across environments.

async function getEnvironmentVariableCurrentValue(schemaName) {
    "use strict";

    const query =
        "?$select=defaultvalue" +
        "&$filter=schemaname eq '" + schemaName + "'" +
        "&$expand=environmentvariabledefinition_environmentvariablevalue($select=value)";

    const result = await Xrm.WebApi.retrieveMultipleRecords(
        "environmentvariabledefinition",
        query
    );

    if (!result || !result.entities || result.entities.length < 1) {
        return null;
    }

    const definition = result.entities[0];

    // Prefer current value, fallback to default
    return definition.environmentvariabledefinition_environmentvariablevalue?.length
        ? definition.environmentvariabledefinition_environmentvariablevalue[0].value
        : definition.defaultvalue;
}

/*
 * ============================================================================
 * kofc_Opportunity — EApp SSO (KOFC.Auth + KOFC.Eapp; no userId)
 * ============================================================================
 *
 * Env vars:
 *   kofc_TenantId, kofc_SPAClientId, kofc_EappApiAppId (or kofc_eAppApiAppId),
 *   kofc_EappApiKey, kofc_BoomieAppUrl
 *   (+ kofc_EappURL from existing navigate chain)
 *
 * Web resources:
 *   kofc_authclient.js, kofc_eappClient.js, kofc_authcallback.html, kofc_msalbrowsermin
 * ============================================================================
 */

var AUTH_CLIENT_LIBRARY = "/WebResources/kofc_authclient.js";
var EAPP_CLIENT_LIBRARY = "/WebResources/kofc_eappClient.js";

var AUTH_ENV_VARS = {
    tenantId: "kofc_TenantId",
    clientId: "kofc_SPAClientId",
    apiAppId: "kofc_EappApiAppId",
    apiKey: "kofc_EappApiKey",
    boomiUrl: "kofc_BoomieAppUrl"
};

var AUTH_STATIC_CONFIG = {
    scope: "access_as_user",
    httpMethod: "POST",
    redirectWebResource: "kofc_authcallback.html",
    msalWebResourcePath: "/WebResources/kofc_msalbrowsermin",
    allowRedirect: true,
    debug: false
};

function loadScriptLibrary(path, isReady) {
    return new Promise(function (resolve, reject) {
        if (isReady()) {
            resolve();
            return;
        }
        var script = document.createElement("script");
        script.src = Xrm.Utility.getGlobalContext().getClientUrl() + path;
        script.onload = function () {
            if (isReady()) { resolve(); }
            else { reject(new Error("Library loaded but API missing: " + path)); }
        };
        script.onerror = function () {
            reject(new Error("Failed to load: " + script.src));
        };
        document.head.appendChild(script);
    });
}

function loadEappClients() {
    return loadScriptLibrary(AUTH_CLIENT_LIBRARY, function () {
        return window.KOFC && window.KOFC.Auth;
    }).then(function () {
        return loadScriptLibrary(EAPP_CLIENT_LIBRARY, function () {
            return window.KOFC && window.KOFC.Eapp;
        });
    });
}

async function getAuthConfigFromEnvironment(boomiIntegrationUrl) {
    "use strict";

    var results = await Promise.all([
        getEnvironmentVariableCurrentValue(AUTH_ENV_VARS.tenantId),
        getEnvironmentVariableCurrentValue(AUTH_ENV_VARS.clientId),
        getEnvironmentVariableCurrentValue(AUTH_ENV_VARS.apiAppId),
        getEnvironmentVariableCurrentValue("kofc_eAppApiAppId"), // legacy schema fallback
        getEnvironmentVariableCurrentValue(AUTH_ENV_VARS.apiKey),
        getEnvironmentVariableCurrentValue(AUTH_ENV_VARS.boomiUrl)
    ]);

    var tenantId = results[0];
    var clientId = results[1];
    var apiAppId = results[2] || results[3];
    var apiKey = results[4];
    var boomiUrl = results[5] || boomiIntegrationUrl;

    var missing = [];
    if (!tenantId) { missing.push(AUTH_ENV_VARS.tenantId); }
    if (!clientId) { missing.push(AUTH_ENV_VARS.clientId); }
    if (!apiAppId) { missing.push(AUTH_ENV_VARS.apiAppId); }
    if (!apiKey) { missing.push(AUTH_ENV_VARS.apiKey); }
    if (!boomiUrl) { missing.push(AUTH_ENV_VARS.boomiUrl); }
    if (missing.length > 0) {
        throw new Error("Missing EApp SSO configuration value(s): " + missing.join(", "));
    }

    return {
        tenantId: tenantId,
        clientId: clientId,
        apiAppId: apiAppId,
        apiKey: apiKey,
        boomiUrl: boomiUrl,
        scope: AUTH_STATIC_CONFIG.scope,
        httpMethod: AUTH_STATIC_CONFIG.httpMethod,
        redirectWebResource: AUTH_STATIC_CONFIG.redirectWebResource,
        msalWebResourcePath: AUTH_STATIC_CONFIG.msalWebResourcePath,
        allowRedirect: AUTH_STATIC_CONFIG.allowRedirect,
        debug: AUTH_STATIC_CONFIG.debug
    };
}

/**
 * Called by navigateToEapp after member/contact check.
 * No userId — Function identity from SPA token oid.
 *
 * Requires published web resources:
 *   kofc_authclient.js  (KOFC.Auth)
 *   kofc_eappClient.js  (KOFC.Eapp)  ← openEapp lives HERE, not on Auth
 */
async function callEappFunctionAPP(opportunityId, eappUrl, boomiIntegrationUrl) {
    "use strict";

    Xrm.Utility.showProgressIndicator("Processing Request... Please Wait.");

    try {
        await loadEappClients();

        if (!window.KOFC || !window.KOFC.Eapp || typeof window.KOFC.Eapp.openEapp !== "function") {
            throw new Error(
                "KOFC.Eapp.openEapp is not available. Publish web resource " +
                "kofc_eappClient.js (Name must include .js), then hard-refresh the form."
            );
        }

        var authConfig = await getAuthConfigFromEnvironment(boomiIntegrationUrl);
        KOFC.Eapp.configure(authConfig);
        // Prefer Eapp (correct API). Do not call KOFC.Auth.openEapp.
        await KOFC.Eapp.openEapp(opportunityId, eappUrl);
        Xrm.Utility.closeProgressIndicator();
    } catch (err) {
        Xrm.Utility.closeProgressIndicator();
        Xrm.Navigation.openAlertDialog({
            text: (err && err.message) ? err.message : String(err)
        });
    }
}
