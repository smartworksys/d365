                formID = kccfFormID;
            }
        }
        else if (opportunityTypeValue === opportunityType.InstitutionalInvestment) {
            if (institutionalinvestmentFormID.toLowerCase() !== currentFormID.toLowerCase()) {
                formID = institutionalinvestmentFormID;
            }
        }
        else if (opportunityTypeValue === opportunityType.Charity) {
            if (charityFormID.toLowerCase() !== currentFormID.toLowerCase()) {
                formID = charityFormID;
            }
        }
        else if (opportunityTypeValue === opportunityType.RetailInvestment) {
            if (retailInvestmentFormID.toLowerCase() !== currentFormID.toLowerCase()) {
                formID = retailInvestmentFormID;
            }
        }
        else if (opportunityTypeValue === opportunityType.Recruiting) {
            if (recruitingFormID.toLowerCase() !== currentFormID.toLowerCase()) {
                formID = recruitingFormID;
            }
        }

        Xrm.Navigation.openForm(
            {
                entityName: "opportunity",
                entityId: recordId,
                formId: formID
            }
        ).then(
            function success(result) {
                // Form loaded successfully
                //here we should call bpf load
                   

            },
            function error(error) {
                // Error occurred while loading the form
                Xrm.Navigation.openAlertDialog('Error in loading form ' + (error.description || error.message));
            }
        );

    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in SetFormAndBPFStage: ' + (error.description || error.message));
        return false;
    }
}

