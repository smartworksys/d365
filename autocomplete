function SetFormAndBPFStage(executionContext) {
    "use strict";
    var formContext = executionContext.getFormContext();
    var opportunityTypeValue = formContext.getAttribute('kofc_opportunitytype').getValue();
    var currentFormID = formContext.ui.formSelector.getCurrentItem().getId();
    var currentProcessName = formContext.data.process.getActiveProcess();
    var formType = formContext.ui.getFormType();
    var recordId = formContext.data.entity.getId();
    var formID;

    var parameters = {};

    try {
        if (opportunityTypeValue === opportunityType.NewCouncilDevelopment || opportunityTypeValue === opportunityType.NewMember || opportunityTypeValue === opportunityType.CouncilReactivation || opportunityTypeValue === opportunityType.EstablishCor) {
            if (fraternalFormID.toLowerCase() !== currentFormID.toLowerCase()) {
                formID = fraternalFormID;
            }
        }
        else if (opportunityTypeValue === opportunityType.NeedInsurance) {
            if (insuranceFormID.toLowerCase() !== currentFormID.toLowerCase()) {
