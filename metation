============================================================
Application Insights - KQL Queries for Presenting Requests
============================================================
Run in: Application Insights → Logs
Note: Sampling must be disabled in host.json for complete data.


------------------------------------------------------------
1. ALL REQUESTS (Full Detail)
------------------------------------------------------------

requests
| where timestamp > ago(30d)
| project
    timestamp,
    endpoint = name,
    httpStatus = resultCode,
    success,
    durationMs = round(duration, 0),
    userAgent = tostring(customDimensions["User-Agent"]),
    userId = coalesce(
        user_AuthenticatedId,
        user_Id,
        tostring(customDimensions["oid"]),
        tostring(customDimensions["userId"]),
        ""
    ),
    clientIP = client_IP,
    clientCity = client_City,
    clientState = client_StateOrProvince,
    operationId = operation_Id,
    customProps = customDimensions
| order by timestamp desc


------------------------------------------------------------
2. DISCOVER IDENTITY FIELDS (Run this first to see where user ID lives)
------------------------------------------------------------

requests
| where timestamp > ago(7d)
| take 50
| project
    timestamp,
    endpoint = name,
    oid = tostring(customDimensions["oid"]),
    userName = tostring(customDimensions["userName"]),
    authMode = tostring(customDimensions["authMode"]),
    user_Id,
    user_AuthenticatedId,
    user_AccountId,
    session_Id,
    client_IP,
    customDimensions


------------------------------------------------------------
3. USER ACTIVITY REPORT (Uses all possible identity fields)
------------------------------------------------------------

requests
| where timestamp > ago(30d)
| extend
    oid = tostring(customDimensions["oid"]),
    userName = tostring(customDimensions["userName"]),
    authMode = tostring(customDimensions["authMode"])
| extend userIdentity = coalesce(oid, user_AuthenticatedId, user_Id, client_IP)
| extend displayName = coalesce(userName, userIdentity)
| where isnotempty(userIdentity) and userIdentity != ""
| summarize
    totalRequests = count(),
    firstSeen = min(timestamp),
    lastSeen = max(timestamp),
    distinctEndpoints = dcount(name),
    endpoints = make_set(name, 20),
    statusCodes = make_set(resultCode, 10),
    avgDuration = round(avg(duration), 0)
    by userIdentity, displayName, authMode
| order by lastSeen desc


------------------------------------------------------------
4. DAILY ACTIVE USERS (Counts by available identity)
------------------------------------------------------------

requests
| where timestamp > ago(30d)
| extend
    oid = tostring(customDimensions["oid"]),
    userName = tostring(customDimensions["userName"])
| extend userIdentity = coalesce(oid, user_AuthenticatedId, user_Id, client_IP)
| where isnotempty(userIdentity) and userIdentity != ""
| summarize
    uniqueUsers = dcount(userIdentity),
    totalCalls = count(),
    avgDurationMs = round(avg(duration), 0),
    failedCalls = countif(toint(resultCode) >= 400)
    by Day = bin(timestamp, 1d)
| extend failRate = round(100.0 * failedCalls / totalCalls, 1)
| order by Day desc


------------------------------------------------------------
5. FAILED REQUESTS (401 / 403 / 500 with full context)
------------------------------------------------------------

requests
| where timestamp > ago(30d)
| where toint(resultCode) >= 400
| extend
    oid = tostring(customDimensions["oid"]),
    userName = tostring(customDimensions["userName"]),
    authMode = tostring(customDimensions["authMode"])
| extend userIdentity = coalesce(oid, user_AuthenticatedId, user_Id, client_IP)
| project
    timestamp,
    endpoint = name,
    httpStatus = resultCode,
    userName,
    userOid = oid,
    authMode,
    durationMs = round(duration, 0),
    clientIP = client_IP,
    operationId = operation_Id,
    customProps = customDimensions
| order by timestamp desc


------------------------------------------------------------
6. SPECIFIC USER LOOKUP (Replace OID or email)
------------------------------------------------------------

let targetUser = "PUT-OID-OR-EMAIL-HERE";
requests
| where timestamp > ago(30d)
| extend
    oid = tostring(customDimensions["oid"]),
    userName = tostring(customDimensions["userName"]),
    authMode = tostring(customDimensions["authMode"])
| where oid == targetUser
    or userName == targetUser
    or client_IP == targetUser
    or user_AuthenticatedId == targetUser
| project
    timestamp,
    endpoint = name,
    httpStatus = resultCode,
    durationMs = round(duration, 0),
    userName,
    userOid = oid,
    authMode,
    clientIP = client_IP
| order by timestamp desc


------------------------------------------------------------
7. EXPORT-FRIENDLY (For InfoSec Spreadsheet)
------------------------------------------------------------

requests
| where timestamp > ago(30d)
| extend
    oid = tostring(customDimensions["oid"]),
    userName = tostring(customDimensions["userName"]),
    authMode = tostring(customDimensions["authMode"])
| project
    Date = format_datetime(timestamp, "yyyy-MM-dd"),
    Time = format_datetime(timestamp, "HH:mm:ss"),
    User_Name = userName,
    User_OID = oid,
    Auth_Mode = authMode,
    Endpoint = name,
    HTTP_Status = resultCode,
    Success = success,
    Duration_ms = round(duration, 0),
    Client_IP = client_IP,
    City = client_City,
    State = client_StateOrProvince,
    Operation_Id = operation_Id
| order by Date desc, Time desc


------------------------------------------------------------
8. REQUESTS + LINKED EXCEPTIONS (Correlate errors)
------------------------------------------------------------

requests
| where timestamp > ago(30d)
| join kind=leftouter (
    exceptions
    | where timestamp > ago(30d)
    | project
        operation_Id,
        exceptionType = type,
        exceptionMessage = outerMessage
  ) on operation_Id
| where isnotempty(exceptionType)
| project
    timestamp,
    endpoint = name,
    httpStatus = resultCode,
    exceptionType,
    exceptionMessage,
    clientIP = client_IP,
    durationMs = round(duration, 0)
| order by timestamp desc


------------------------------------------------------------
9. HOURLY TRAFFIC PATTERN (Spot anomalies)
------------------------------------------------------------

requests
| where timestamp > ago(7d)
| summarize
    callCount = count(),
    failCount = countif(toint(resultCode) >= 400),
    avgDuration = round(avg(duration), 0),
    p95Duration = round(percentile(duration, 95), 0)
    by bin(timestamp, 1h)
| extend failRate = round(100.0 * failCount / callCount, 1)
| order by timestamp desc


============================================================
NOTES:
------------------------------------------------------------
- Run Query #2 FIRST to verify telemetry is flowing correctly.
- After deployment, customDimensions will contain:
    "oid"      = Entra Object ID of the caller
    "userName" = UPN/email from X-MS-CLIENT-PRINCIPAL-NAME
    "authMode" = "delegated" or "app"
- These are set via Activity.Current.SetTag() in each Function.
- Files changed to add telemetry:
    KOFC-FA-PolicyNonHeader-TierOne\PolicyData.cs
    KOFC-FA-AgentPortal-UserProfile\EappSSO.cs
    proxyBlobFunction\KOFC.Azure.Functions.GetSaasBlobUrl\GetSaasBlobUrl.cs
- Click "Export → CSV" after running any query.
- Adjust "ago(30d)" to change the time window.
- Ensure host.json has sampling disabled:
    "samplingSettings": { "isEnabled": false }
